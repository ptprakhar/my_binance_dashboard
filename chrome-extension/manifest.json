{
  "manifest_version": 3,
  "name": "Binance Risk Guard",
  "version": "0.2.0",
  "description": "Personal Binance Futures risk guard. Reads risk state from the dashboard and calculates safe market-order size from the live market price and stop loss.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "http://localhost:8787/*",
    "https://*.workers.dev/*",
    "https://*.pages.dev/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Binance Risk Guard",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.binance.com/*", "https://binance.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
