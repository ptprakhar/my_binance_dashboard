[Unit]
Description=Binance Dashboard fixed-IP backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/my-binance-dashboard/backend
EnvironmentFile=/etc/binance-dashboard.env
ExecStart=/usr/bin/node /opt/my-binance-dashboard/backend/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/my-binance-dashboard/backend

[Install]
WantedBy=multi-user.target
