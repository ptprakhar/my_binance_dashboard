{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-binance-dashboard",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-08",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
